{
  "schema": 1,
  "comment": "D3 launch allowlist consumed by runner/hf/launch.py. Every flag below was checked to exist in ComfyUI 0.30.1 (the image pin) and 0.39.0 comfy/cli_args.py on 2026-11-20 (--disable-partner-nodes added 2026-11-23, checked in 0.39.0). WS7 re-checks it against the pinned ComfyUI at build time (python3.13 runner/hf/launch.py runner/launch_allowlist.json $COMFYUI_DIR/comfy/cli_args.py).",
  "verified_against": [
    "ComfyUI 0.30.1 comfy/cli_args.py (image pin)",
    "ComfyUI 0.39.0 comfy/cli_args.py"
  ],
  "flags": {
    "--use-sage-attention": {"value": "none", "requires_module": "sageattention"},
    "--use-flash-attention": {"value": "none", "requires_module": "flash_attn"},
    "--use-pytorch-cross-attention": {"value": "none"},
    "--use-split-cross-attention": {"value": "none"},
    "--use-quad-cross-attention": {"value": "none"},
    "--disable-xformers": {"value": "none"},
    "--reserve-vram": {"value": "float", "min": 0, "max": 64},
    "--vram-headroom": {"value": "float", "min": 0, "max": 64},
    "--disable-pinned-memory": {"value": "none"},
    "--disable-async-offload": {"value": "none"},
    "--async-offload": {"value": "int_optional", "min": 1, "max": 8},
    "--disable-dynamic-vram": {"value": "none"},
    "--disable-smart-memory": {"value": "none"},
    "--disable-mmap": {"value": "none"},
    "--fast-disk": {"value": "none"},
    "--fast": {"value": "choices_multi", "choices": ["fp16_accumulation", "fp8_matrix_mult", "cublas_ops", "autotune"]},
    "--cache-none": {"value": "none"},
    "--cache-classic": {"value": "none"},
    "--cache-lru": {"value": "int", "min": 0, "max": 10000},
    "--cache-ram": {"value": "floats", "min": 0, "max": 1024, "max_count": 2},
    "--preview-method": {"value": "choice", "choices": ["none", "auto", "latent2rgb", "taesd"]},
    "--preview-size": {"value": "int", "min": 64, "max": 2048},
    "--lowvram": {"value": "none"},
    "--novram": {"value": "none"},
    "--highvram": {"value": "none"},
    "--gpu-only": {"value": "none"},
    "--verbose": {"value": "choice_optional", "choices": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]},
    "--log-stdout": {"value": "none"},
    "--deterministic": {"value": "none"},
    "--fp32-vae": {"value": "none"},
    "--bf16-vae": {"value": "none"},
    "--fp16-vae": {"value": "none"},
    "--cpu-vae": {"value": "none"},
    "--force-fp16": {"value": "none"},
    "--force-channels-last": {"value": "none"},
    "--disable-cuda-malloc": {"value": "none"},
    "--disable-partner-nodes": {"value": "none"}
  },
  "denied": {
    "--listen": "set by the runner (loopback only)",
    "--port": "set by the runner",
    "--output-directory": "set by the runner",
    "--input-directory": "set by the runner",
    "--temp-directory": "set by the runner",
    "--extra-model-paths-config": "set by the runner",
    "--base-directory": "changes every directory the runner relies on",
    "--user-directory": "changes directories the runner relies on",
    "--models-directory": "model locations come from MODEL_BASE_DIR",
    "--enable-cors-header": "opens the ComfyUI API to other origins",
    "--tls-keyfile": "not used inside the container",
    "--tls-certfile": "not used inside the container",
    "--front-end-version": "downloads front-end code at start-up",
    "--front-end-root": "not used inside the container",
    "--enable-manager": "ComfyUI-Manager can install arbitrary code",
    "--database-url": "not configurable per job",
    "--cpu": "a GPU job must not silently run on the CPU",
    "--directml": "not supported in the runtime image",
    "--multi-user": "not used inside the container",
    "--auto-launch": "no browser inside the container",
    "--whitelist-custom-nodes": "the node set is fixed by the runtime profile",
    "--disable-all-custom-nodes": "the node set is fixed by the runtime profile"
  },
  "exclusive_groups": [
    ["--gpu-only", "--highvram", "--lowvram", "--novram"],
    ["--use-split-cross-attention", "--use-quad-cross-attention", "--use-pytorch-cross-attention", "--use-sage-attention", "--use-flash-attention"],
    ["--cache-classic", "--cache-lru", "--cache-none", "--cache-ram"],
    ["--fp16-vae", "--fp32-vae", "--bf16-vae"],
    ["--async-offload", "--disable-async-offload"]
  ],
  "env": {
    "PYTORCH_CUDA_ALLOC_CONF": {"pattern": "^[a-z_]+:[A-Za-z0-9.]+(,[a-z_]+:[A-Za-z0-9.]+)*$"},
    "CUDA_LAUNCH_BLOCKING": {"choices": ["0", "1"]},
    "CUDA_MODULE_LOADING": {"choices": ["LAZY", "EAGER"]}
  },
  "presets": {
    "safe": {"label": "Safe", "description": "Stock ComfyUI settings.", "args": [], "env": {}, "ladder": null},
    "fast": {"label": "Fast", "description": "ComfyUI --fast optimizations (ComfyUI calls them untested and potentially quality deteriorating).", "args": ["--fast"], "env": {}, "ladder": null},
    "max_memory": {"label": "Max Memory", "description": "Aggressive offloading, no pinned host memory, 1 GB VRAM reserve, expandable CUDA segments; tiled decode allowed as a recovery step.", "args": ["--disable-smart-memory", "--disable-pinned-memory", "--reserve-vram", "1.0"], "env": {"PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"}, "ladder": ["resubmit_cached", "decode_tiled", "decode_from_latent"]},
    "debug": {"label": "Debug", "description": "Verbose ComfyUI logging and synchronous CUDA errors (slower).", "args": ["--verbose", "DEBUG"], "env": {"CUDA_LAUNCH_BLOCKING": "1"}, "ladder": null},
    "sage": {"label": "SageAttention (experimental)", "description": "ComfyUI --use-sage-attention. Needs an image built with ATTENTION=sage (SageAttention 1.0.6, Triton). GPU speed-up and output parity NOT VERIFIED.", "args": ["--use-sage-attention"], "env": {}, "ladder": null}
  },
  "default_ladder": ["resubmit_cached", "decode_from_latent"],
  "memory_safe_restart_args": ["--disable-pinned-memory", "--cache-none"]
}
