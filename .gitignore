# Python caches and environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Secrets and local settings: never commit them (NEW_WORK sections 13 and 16).
.env
.env.*
!.env.example
# Settings and credential files can hold the account password or the service endpoint. They live in ComfyUI's
# user folder at runtime; these lines guard against a copy landing in the checkout.
halofuse_settings.json
halofuse_settings.json.*
# any older settings file name too
*_settings.json
*_settings.json.*
credentials.json
deployment.json
*.migrated
# quarantined unreadable settings / credential files (WS1 credentials.py)
*.corrupt-*

# Model weights and media: never in the repository
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.onnx

# ComfyUI data folders (when the checkout sits inside a ComfyUI tree for testing)
/input/
/output/

# Tool caches, logs and test artefacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log
node_modules/
test-results/
playwright-report/

# Build artefacts and archives
dist/
build/
*.egg-info/
*.zip
*.whl

# Editor, agent and OS files
.claude/
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Tests stay local (owner rule 2026-10-23): the suites live on the developer's disk, never in the published repository.
/tests/
/runtime/tests/
/runtime/pytest.ini
/docs/testing.md
